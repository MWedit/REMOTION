{
	"compilerOptions": {
		"target": "ES2018",
		"module": "ESNext",
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"lib": ["ES2018", "DOM"]
	},
	"include": ["src", "remotion.config.ts"]
}
